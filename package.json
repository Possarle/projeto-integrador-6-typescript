{
  "name": "projeto-integrador-6-typescript",
  "version": "2.0.0",
  "private": true,
  "description": "CRUD de produtos em TypeScript, Express, Sequelize e SQLite",
  "main": "dist/index.js",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.frontend.json",
    "start": "node dist/index.js",
    "dev": "npm run build && tsx watch src/index.ts",
    "test": "jest --runInBand --coverage",
    "test:watch": "jest --watch",
    "check": "npm run build && npm test"
  },
  "dependencies": { "express": "^5.1.0", "sequelize": "^6.37.7", "sqlite3": "^5.1.7" },
  "devDependencies": { "@types/express": "^5.0.3", "@types/jest": "^29.5.14", "@types/node": "^22.0.0", "@types/supertest": "^6.0.3", "jest": "^29.7.0", "jest-environment-jsdom": "^29.7.0", "supertest": "^7.1.4", "ts-jest": "^29.4.5", "tsx": "^4.20.0", "typescript": "^5.9.3" }
}
